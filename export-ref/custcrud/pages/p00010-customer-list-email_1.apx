page 10 (
    name: Customer List - Email
    alias: CUSTOMER-LIST-EMAIL
    title: Customer List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region customer-list-email (
        name: Customers (Email View)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_id,
                       name,
                       email,
                       '[Edit](f?p=&APP_ID.:20:&SESSION.::&DEBUG.::P20_CUSTOMER_ID:' || customer_id || ')' as edit_link,
                       '[View](f?p=&APP_ID.:20:&SESSION.::&DEBUG.::P20_CUSTOMER_ID,P20_MODE:' || customer_id || ',VIEW)' as view_link
                from   customer
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        advanced {
            savedReportMappingIdentifier: 2408182726078117
        }

        column CUSTOMER_ID (
            type: hidden
            heading {
                heading: Customer Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column EDIT_LINK (
            type: richText
            heading {
                heading: Edit
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column VIEW_LINK (
            type: richText
            heading {
                heading: View
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CUSTOMER_ID (
                sequence: 1
            )

            displayColumn EDIT_LINK (
                sequence: 4
            )

            displayColumn EMAIL (
                sequence: 3
            )

            displayColumn NAME (
                sequence: 2
            )

            displayColumn VIEW_LINK (
                sequence: 5
            )

        )

    )

    button new-customer (
        buttonName: NEW_CUSTOMER
        label: New Customer
        layout {
            sequence: 20
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20
            }
        }
    )

    button view-phone-list (
        buttonName: VIEW_PHONE_LIST
        label: View Phone List
        layout {
            sequence: 10
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
            }
        }
    )

)

