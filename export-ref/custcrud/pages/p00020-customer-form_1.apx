page 20 (
    name: Customer Form
    alias: CUSTOMER-FORM
    title: Customer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region customer-form (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: CUSTOMER
        }
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P20_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: CUSTOMER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
    )

    pageItem P20_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 30
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P20_MODE (
        type: hidden
        layout {
            sequence: 15
            region: @customer-form
            slot: regionBody
        }
    )

    pageItem P20_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 20
            region: @customer-form
            slot: regionBody
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @customer-form
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P20_PHONE (
        type: textField
        label {
            label: Phone
        }
        layout {
            sequence: 40
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: PHONE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 30
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this customer?
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
    )

    process fetch-row (
        name: Fetch Row from CUSTOMER
        type: autoRowFetch
        source {
            tableName: CUSTOMER
            pkColumn: CUSTOMER_ID
            pkItem: P20_CUSTOMER_ID
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2416648758265356
        }
    )

    process process-row (
        name: Process Row of CUSTOMER
        type: formAutoRowProcessing
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2416780930265356
        }
    )

)

