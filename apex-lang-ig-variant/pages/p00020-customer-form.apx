page 20 (
    name: Customer Form
    alias: CUSTOMER-FORM
    title: Customer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region customer-form (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: CUSTOMER
        }
        layout {
            sequence: 10
            slot: body
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P20_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: CUSTOMER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
    )

    pageItem P20_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 20
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: NAME
            dataType: varchar2
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P20_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 30
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P20_PHONE (
        type: textField
        label {
            label: Phone
        }
        layout {
            sequence: 40
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: PHONE
            dataType: varchar2
        }
    )

    button save (
        identification {
            buttonName: SAVE
            label: Save
        }
        layout {
            sequence: 10
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: submitPage
        }
    )

    button delete (
        identification {
            buttonName: DELETE
            label: Delete
        }
        layout {
            sequence: 20
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure you want to delete this customer?
        }
    )

    button cancel (
        identification {
            buttonName: CANCEL
            label: Cancel
        }
        layout {
            sequence: 30
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
        }
    )
)
