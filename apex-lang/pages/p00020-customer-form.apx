page 20 (
    name: Customer Form
    alias: CUSTOMER-FORM
    title: Customer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region customer-form (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: CUSTOMER
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P20_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: CUSTOMER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
    )

    pageItem P20_MODE (
        type: hidden
        layout {
            sequence: 15
            region: @customer-form
            slot: regionBody
        }
    )

    pageItem P20_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 20
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: NAME
            dataType: varchar2
        }
        validation {
            valueRequired: true
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: :P20_MODE = 'VIEW'
        }
    )

    pageItem P20_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 30
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: EMAIL
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: :P20_MODE = 'VIEW'
        }
    )

    pageItem P20_PHONE (
        type: textField
        label {
            label: Phone
        }
        layout {
            sequence: 40
            region: @customer-form
            slot: regionBody
        }
        source {
            formRegion: @customer-form
            column: PHONE
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: :P20_MODE = 'VIEW'
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @customer-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @customer-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            databaseAction: delete
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Are you sure you want to delete this customer?
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 30
            region: @customer-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form (
        name: Initialize form Customer
        type: formInitialization
        formRegion: @customer-form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-row (
        name: Process Row of CUSTOMER
        type: formAutoRowProcessing
        formRegion: @customer-form
        execution {
            sequence: 10
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 10
            }
        }
    )
)
